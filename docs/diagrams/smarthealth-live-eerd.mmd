    CLIENT ||--o{ USER_AUTH : "has login"
    CLIENT ||--o| LANGUAGE_SETTINGS : "prefers"
    CLIENT ||--o{ DEVICES : "owns"
    CLIENT ||--o{ PULSE_READINGS : "has"
    CLIENT ||--o{ TEMPERATURE_READINGS : "has"
    CLIENT ||--o{ BLOOD_PRESSURE_READINGS : "has"
    CLIENT ||--o{ HEALTH_SYNC_SECTIONS : "syncs"
    CLIENT ||--o{ DEVICE_SYNC_EVENTS : "creates"
    CLIENT ||--o{ EMERGENCY_ALERTS : "triggers"
    CLIENT ||--o{ VOICE_LOGS : "creates"
    CLIENT ||--o{ PASSWORD_RESET_OTPS : "requests"
    CLIENT ||--o{ AI_CHAT_MESSAGES : "sends"

    DEVICES ||--o{ PULSE_READINGS : "records"
    DEVICES ||--o{ TEMPERATURE_READINGS : "records"
    DEVICES ||--o{ BLOOD_PRESSURE_READINGS : "records"
    DEVICES ||--o{ HEALTH_SYNC_SECTIONS : "summarizes"
    DEVICES ||--o{ DEVICE_SYNC_EVENTS : "logs"

    HOSPITAL_USER }o--|| HOSPITALS : "works for"
    HOSPITALS ||--o{ HOSPITAL_AUTH : "has login"
